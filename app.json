{
  "expo": {
    "name": "PlanUs",
    "slug": "my-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/planus-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/brand/planus-adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "Planus",
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/brand/planus-symbol.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand/planus-splash-ios.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#1DA7E0",
          "android": {
            "image": "./assets/images/brand/planus-splash-android.png",
            "imageWidth": 200
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ]
    ]
  }
}
